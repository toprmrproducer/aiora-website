{
  "name": "aiora-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "build:gh": "GH_PAGES=1 npm run build",
    "preview": "vite preview",
    "deploy": "GH_PAGES=1 npm run build && npx gh-pages -d dist --nojekyll -m 'deploy aiora website'"
  },
  "homepage": "https://toprmrproducer.github.io/aiora-website",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^11.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
